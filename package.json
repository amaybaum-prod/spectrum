  "scripts": {
    "prettier": "prettier --write \"**/*.{ts,js,css,scss,json}\"",
    "start:docs": "yarn workspace docs start",
    "start:webapp": "yarn workspace spectrum-webapp babel-watch",
    "start:mobile-api": "yarn workspace mobile-api babel-watch",
    "start:hyperion-api": "yarn workspace hyperion babel-watch",
    "build:docs": "yarn workspace docs build",
    "build:webapp": "yarn workspace spectrum-webapp build",
    "build:mobile-api": "yarn workspace mobile-api build",
    "build:hyperion-api": "yarn workspace hyperion build",
    "test": "yarn jest --maxWorkers=2",
    "test:jest": "yarn jest --maxWorkers=2",
    "test:e2e": "yarn workspace spectrum-e2e test",
    "lint": "yarn eslint . --ext .ts,.tsx --quiet",
    "fix": "yarn prettier && yarn lint --fix",
    "typecheck": "tsc -p . --noEmit"
  },
  "workspaces": [
    "packages/*"
  ],
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(@spectrum-chat)/)"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/jestSetupFiles*"
    ],
    "coverageReporters": [
      "lcov",
      "text-summary"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/../../jestSetupFiles/cssStub.js"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/../../jestSetupFiles/setupFiles.js"
    ]
  }
}
